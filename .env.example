# Supabase 프로젝트 설정 (Supabase 대시보드 > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # 절대 브라우저/클라이언트에 노출하지 마세요

# 매일 자동으로 바뀌는 4자리 출석 코드를 만들 때 사용하는 비밀키.
# 아무 문자열이나 충분히 길고 예측 불가능하게 설정하세요. (예: openssl rand -hex 32)
DAILY_CODE_SECRET=change-me-to-a-long-random-string
